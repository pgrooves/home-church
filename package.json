{
  "name": "home-church",
  "version": "1.0.0",
  "private": true,
  "description": "Home Church, Metairie. Sermons, small group guides, and a way in.",
  "license": "UNLICENSED",
  "scripts": {
    "test": "node tests/rooms.test.js && sh supabase/tests/run.sh",
    "test:js": "node tests/rooms.test.js",
    "test:db": "sh supabase/tests/run.sh",
    "test:e2e": "sh tests/e2e/run.sh",
    "test:all": "npm run test && npm run test:e2e",
    "stamp": "node scripts/stamp_assets.js",
    "sync": "node scripts/sync_web.js",
    "ios": "npm run stamp && npm run sync && npx cap sync ios",
    "ios:open": "npm run ios && npx cap open ios",
    "icons": "python3 scripts/make_icons.py"
  },
  "dependencies": {
    "@capacitor/app": "^8.0.0",
    "@capacitor/browser": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/filesystem": "^8.0.0",
    "@capacitor/haptics": "^8.0.0",
    "@capacitor/ios": "^8.0.0",
    "@capacitor/push-notifications": "^8.0.0",
    "@capacitor/share": "^8.0.0",
    "@capacitor/splash-screen": "^8.0.0",
    "@capacitor/status-bar": "^8.0.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.0.0",
    "playwright-core": "^1.62.1"
  }
}
