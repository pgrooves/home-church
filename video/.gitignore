# The staged copy of the app. Written by prepare.mjs from the repo above this
# folder, so it is never the source of anything and committing it would put a
# second copy of js/ and css/ in the history every time either one moved.
public/app/

# Rendered video.
out/

node_modules/

# The music. A licensed track, so the licence lives with whoever holds it
# rather than in a git history. prepare.mjs says what to do if it is absent.
public/music.wav

# Apple's badge, fetched from developer.apple.com by hand. Their artwork,
# their licence; the guidelines ask for the supplied file rather than a
# redrawn one, and a redrawn one is a trademark somebody traced.
public/app-store-badge.svg
