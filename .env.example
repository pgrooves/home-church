# Copy this file to `.env` and fill in the values. `.env` is git ignored.
#
# Where to find them: Supabase dashboard -> your project -> Project Settings
# -> API keys.
#
# SUPABASE_URL is the Project URL. The random looking string in it is the
# project ref, and it is how you tell your two similarly named projects
# apart. The app already ships pointed at one of them in `js/config.js`.
# Run `python3 scripts/hc_supabase.py check` to see which ref your .env is
# aimed at and whether it matches the app.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key, the secret one. It bypasses row level security
# entirely, so it can write every content table. Never paste it into
# `js/config.js`, never put it in anything the app downloads, never commit
# it. Only this file, and only on your own machine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Optional, and only `scripts/resolve_songs.js` reads it. With a token, a
# worship setlist gets its lyrics links filled in automatically; without one,
# every song's `lyricsUrl` is left empty and the Worship screen simply draws
# no Lyrics link, which is the right answer rather than a degraded one. The
# album art and the Apple Music link do not need this, or any key at all.
#
# Where to find it: genius.com/api-clients -> New API Client -> generate a
# client access token. Read only, and it costs nothing.
GENIUS_TOKEN=

# Optional, and only `scripts/resolve_songs.js` reads it. This one buys the
# Spotify, YouTube, YouTube Music, Amazon and Tidal links on every song.
#
# It used to be unnecessary. Odesli ran an open endpoint for years, which is
# what this script was built against, and in 2026 that tier was retired: the
# API now answers 401 PUBLIC_API_ACCESS_DEPRECATED to any request without a
# key. Without one, a set still publishes with real album art, canonical
# titles and Apple Music links, and the Worship screen draws one button per
# song instead of six. Nothing is guessed to fill the gap.
#
# It cannot be replaced by searching the web for the links. A worship title
# is not unique enough: "Holy Spirit" by Jesus Culture alone has five
# different Spotify recordings, live and radio and re-releases, and the one
# that belongs on the screen is the one the band actually played. Odesli is
# worth a key because it matches on the recording's identity rather than on
# its name.
#
# Where to find it: odesli.co -> API -> request a key.
ODESLI_API_KEY=
