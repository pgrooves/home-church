# Copy this file to `.env` and fill in the two values. `.env` is git ignored.
#
# Where to find them: Supabase dashboard -> your project -> Project Settings
# -> API keys.
#
# SUPABASE_URL is the Project URL. The random looking string in it is the
# project ref, and it is how you tell your two similarly named projects
# apart. The app already ships pointed at one of them in `js/config.js`.
# Run `python3 scripts/hc_supabase.py check` to see which ref your .env is
# aimed at and whether it matches the app.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key, the secret one. It bypasses row level security
# entirely, so it can write every content table. Never paste it into
# `js/config.js`, never put it in anything the app downloads, never commit
# it. Only this file, and only on your own machine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Only `scripts/hc_auth.py` needs this one, and only for the one time job of
# fixing the sign-in emails, see supabase/auth/README.md. It is a personal
# access token from https://supabase.com/dashboard/account/tokens, a third
# thing again from both keys above: it reaches project settings, which live
# outside the database, rather than reaching the data. Leave it out if you
# are not running that script.
SUPABASE_ACCESS_TOKEN=sbp_your-personal-access-token
