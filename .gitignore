# Secrets. The service role key lives here and must never be committed.
# `js/config.js` holds the anon publishable key on purpose, that one is safe
# in client code because row level security is what actually gates access.
.env
.env.*
!.env.example

# Local scratch from the publishing scripts
*.local.json
/tmp-guide-*.json

# Seed JSON is generated from js/data.js by scripts/export_seed.js. Committing
# it would be a second copy of the whole catalogue, free to drift from the
# first. Regenerate it instead, it takes a second.
/supabase/seed/

# Capacitor. www/ is assembled from the repo by `npm run sync`, ios/ is
# generated by `npx cap add ios`, and both are disposable. Anything written by
# hand that belongs to the Xcode project lives in ios-config/ instead, which
# is tracked, because git cannot re-include a file inside an ignored directory
# and pretending otherwise is how a hand written file quietly stops being
# backed up.
/www/
/node_modules/
/ios/

# Generated icon set. `npm run icons` rebuilds it from assets/icons/ and it
# only ever lives in Xcode, not in the web app.
/ios-icons/

# OS and editor noise
.DS_Store
Thumbs.db
*.swp
.idea/
.vscode/

# Python, for the scripts in scripts/
__pycache__/
*.pyc
.venv/
venv/

# Personal, per-machine Claude Code overrides. The session-scoped MCP server
# names in here are local to one session and mean nothing to anybody else.
.claude/settings.local.json
