# Copy this file to `.env` and fill in the values. `.env` is git ignored.
#
# Where to find them: Supabase dashboard -> your project -> Project Settings
# -> API keys.
#
# SUPABASE_URL is the Project URL. The random looking string in it is the
# project ref, and it is how you tell your two similarly named projects
# apart. The app already ships pointed at one of them in `js/config.js`.
# Run `python3 scripts/hc_supabase.py check` to see which ref your .env is
# aimed at and whether it matches the app.
SUPABASE_URL=https://your-project-ref.supabase.co

# The service_role key, the secret one. It bypasses row level security
# entirely, so it can write every content table. Never paste it into
# `js/config.js`, never put it in anything the app downloads, never commit
# it. Only this file, and only on your own machine.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ---------------------------------------------------------------------------
# Worship setlists. Only `scripts/resolve_songs.js` reads anything below, and
# every one of them is optional.
#
# WITHOUT ANY OF THEM you still get the two things that matter most, because
# iTunes Search needs no key at all: every song's album art at 600px, and its
# Apple Music link. That is a real setlist screen.
#
# EACH ONE YOU ADD fills in one more row of buttons, from the next run on. A
# platform with no credentials is left out of the row rather than guessed at,
# and the summary says "not set up" rather than "no links", so a missing key
# never reads as a song that is not on Spotify.
#
# Odesli used to do all of these in one call without a key. It retired public
# access to that endpoint, which is why they are now one key per platform.
# ---------------------------------------------------------------------------

# Odesli, if you have a key. One call fills in every platform at once, and
# the three below are then only filling whatever it missed.
# Where to find it: song.link, their API plans.
ODESLI_API_KEY=

# Spotify. Free: developer.spotify.com/dashboard -> Create app. Only the
# client id and secret, no user login, no redirect URL that matters.
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# YouTube. Free: console.cloud.google.com -> APIs -> YouTube Data API v3 ->
# Credentials -> API key. The free quota is far more than a setlist a week.
YOUTUBE_API_KEY=

# Genius, for the lyrics link under each song. Without it every song's
# lyricsUrl is left empty and the Worship screen simply draws no Lyrics link,
# which is the right answer rather than a degraded one.
# Where to find it: genius.com/api-clients -> New API Client -> generate a
# client access token. Read only, and it costs nothing.
GENIUS_TOKEN=
